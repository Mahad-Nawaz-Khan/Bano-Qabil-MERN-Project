# Keep the real values only in the ignored backend/.env file.

# --- Database ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ghalib-restaurant?retryWrites=true&w=majority

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma separated allowlist. Requests from any other origin are rejected.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
# Public URL of the storefront, used to build links inside emails.
APP_URL=http://localhost:5173
# Number of reverse proxies in front of the API (0 when running locally).
TRUST_PROXY=0

# --- Tokens ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_PEPPER=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# lax when the API and site share a site (the default), none for a cross-site deploy.
# "none" forces Secure, so it only works over HTTPS.
COOKIE_SAMESITE=lax

# --- Email (Gmail SMTP) ---
# Requires 2FA on the account plus an App Password: https://myaccount.google.com/apppasswords
# Leave SMTP_USER/SMTP_PASS empty in development: emails are printed to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GHALIB Restaurant <no-reply@ghalib.test>

# --- First admin (npm run seed:admin) ---
ADMIN_NAME=Restaurant Admin
ADMIN_EMAIL=admin@ghalib.test
ADMIN_PASSWORD=change-this-before-running
