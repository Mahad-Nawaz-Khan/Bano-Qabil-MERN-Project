# Do not commit backend/.env. Copy this file to backend/.env and use your own values.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
APP_URL=http://localhost:5173
TRUST_PROXY=0
JWT_ACCESS_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_PEPPER=replace-with-a-different-long-random-string

# Cookie settings — set to "none" when frontend and backend are on different domains
# (e.g. Vercel frontend + Render backend). Use "lax" for same-domain setups.
COOKIE_SAMESITE=lax

# Optional: override default token lifetimes
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (SMTP) — needed for verification, password reset, and order notifications.
# Without these, emails are printed to the console in dev and silently skipped in production.
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=GHALIB Restaurant <your-email@gmail.com>
